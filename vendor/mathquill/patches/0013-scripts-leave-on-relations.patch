diff --git a/src/commands/math.ts b/src/commands/math.ts
--- a/src/commands/math.ts
+++ b/src/commands/math.ts
@@ class MathBlock extends MathElement {
   write(cursor: Cursor, ch: string) {
+    // A character in charsThatBreakOutOfSupSub typed in a non-empty exponent or
+    // subscript leaves it, and any exponent or subscript it sits directly in, for the
+    // line they are written on (`x^{2}=`, `a_{x^{2}}=`); one inside brackets or a
+    // fraction stays there (`y_{1\left\{x>0\right\}}`), and so does the `>` of `->`.
+    var arrow = ch === '>' && cursor[L] && (cursor[L] as MQNode).ctrlSeq === '-';
+    if (
+      !cursor.selection &&
+      !arrow &&
+      (cursor[L] || cursor[R]) &&
+      cursor.options.charsThatBreakOutOfSupSub.indexOf(ch) > -1
+    ) {
+      var outer: MQNode | null = null;
+      for (
+        var block: MQNode | undefined = cursor.parent;
+        block && block.parent && typeof (block.parent as any).supsub === 'string';
+        block = (outer as MQNode).parent
+      ) {
+        outer = block.parent;
+      }
+      if (outer) {
+        cursor.insRightOf(outer);
+        cursor.controller.aria.queue('Baseline');
+      }
+    }
     var cmd = this.chToCmd(ch, cursor.options);
