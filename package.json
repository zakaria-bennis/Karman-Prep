{
  "name": "karman-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"next,stripe\" -c \"blue,green\" \"next dev\" \"stripe listen --forward-to localhost:3000/api/stripe/webhook\"",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:all": "playwright test --project=e2e --project=e2e-firefox --project=e2e-webkit",
    "test:visual": "playwright test --project=visual",
    "test:visual:all": "playwright test --project=visual --project=visual-firefox --project=visual-webkit --project=mobile-chrome --project=mobile-safari",
    "test:visual:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "cf:build": "opennextjs-cloudflare build && node scripts/build/patch-cf-worker.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "pdf:pull": "node --env-file=.env.local scripts/pdf-pipeline/pull-pdf-job.mjs",
    "pdf:watch": "node --env-file=.env.local scripts/pdf-pipeline/pull-pdf-job.mjs --watch",
    "pdf:finalize": "node --env-file=.env.local scripts/pdf-pipeline/finalize-pdf-job.mjs",
    "db:types": "npx supabase gen types typescript --project-id yyocjxvrakuhnvepaevh > src/types/supabase.ts",
    "db:push": "npx supabase db push",
    "db:status": "npx supabase migration list --linked",
    "seed:dev": "node scripts/seed-dev.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@clerk/nextjs": "^7.2.3",
    "@clerk/themes": "^2.4.57",
    "@opennextjs/cloudflare": "^1.19.4",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.53.1",
    "@slack/web-api": "^7.15.1",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/supabase-js": "^2.104.0",
    "@types/d3": "^7.4.3",
    "@types/howler": "^2.2.12",
    "@types/katex": "^0.16.8",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "framer-motion": "^12.38.0",
    "howler": "^2.2.4",
    "ical-generator": "^10.2.0",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "openai": "^6.37.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-useanimations": "^2.10.0",
    "resend": "^6.12.2",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/ui": "^4.1.6",
    "concurrently": "^9.2.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md}": [
      "prettier --write"
    ]
  }
}
