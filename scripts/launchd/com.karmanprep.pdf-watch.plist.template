<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  com.karmanprep.pdf-watch — launchd LaunchAgent that runs the
  PDF queue watcher on this Mac whenever you're logged in.

  Installed to ~/Library/LaunchAgents/com.karmanprep.pdf-watch.plist
  by scripts/launchd/install-pdf-watch.sh.

  Placeholders {{NODE_BIN}} and {{REPO_DIR}} are substituted by the
  installer; do not edit this file in-place after installation.
-->
<dict>
    <key>Label</key>
    <string>com.karmanprep.pdf-watch</string>

    <!-- The node binary + script + flags. Args are an array so each
         element is passed as a separate argv. --env-file ensures the
         Supabase + R2 + CRON_SECRET vars are loaded at startup. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{NODE_BIN}}</string>
        <string>--env-file=.env.local</string>
        <string>scripts/pdf-pipeline/pull-pdf-job.mjs</string>
        <string>--watch</string>
    </array>

    <!-- Run from the repo so question-imports/incoming/ + .env.local resolve. -->
    <key>WorkingDirectory</key>
    <string>{{REPO_DIR}}</string>

    <!-- launchd starts processes with a minimal PATH that omits Homebrew
         (/opt/homebrew/bin) and Claude Code's install dir. We inject:
           · CLAUDE_BIN   — absolute path so the watcher's spawn() finds claude
           · PATH         — also for any sub-tools claude itself may shell to. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>CLAUDE_BIN</key>
        <string>{{CLAUDE_BIN}}</string>
        <key>PATH</key>
        <string>{{PATH_FOR_LAUNCHD}}</string>
    </dict>

    <!-- Start at login. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if the process crashes. SuccessfulExit=false means
         "only restart if exit code != 0" — Ctrl-C in a manual run
         exits 0, so manual stops won't trigger a restart. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Throttle restarts to once every 30s in case of a crash loop. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Log everything (stdout + stderr) to a tail-able file. The
         installer creates the parent directory. Logs append; rotate
         them yourself if they grow unwieldy. -->
    <key>StandardOutPath</key>
    <string>{{REPO_DIR}}/question-imports/.pdf-watch.log</string>
    <key>StandardErrorPath</key>
    <string>{{REPO_DIR}}/question-imports/.pdf-watch.log</string>
</dict>
</plist>
