# ============================================================
# Karman Prep — environment variables
#
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored.
#
# In production, mirror these to Cloudflare Workers via:
#   npx wrangler secret put <NAME>
# ============================================================

# ─── Public site ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://karmanprep.com
NEXT_PUBLIC_KARMAN_LAUNCHED=false      # flip to "true" to remove pre-launch holding page

# ─── Clerk (auth) ───────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your project → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard/student
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── Supabase (database) ────────────────────────────────────
# Project settings → API. The anon key is public-safe; the service-role
# key bypasses RLS — server-side only, never expose to the client.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx
SUPABASE_DB_WEBHOOK_SECRET=                  # signs DB webhook payloads → /api/webhooks/supabase

# ─── Stripe (payments + tutor payouts) ──────────────────────
# Use sk_test_/pk_test_ keys for development. Switch to sk_live_ for production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx              # platform webhook (subscriptions, invoices)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx      # Connect events (account.updated, payout.paid)

# Stripe Price IDs — create products in dashboard, paste the price_xxx values
STRIPE_PRICE_GROUP_MONTHLY=price_xxx
STRIPE_PRICE_SMALL_GROUP=price_xxx
STRIPE_PRICE_PRIVATE=price_xxx
STRIPE_PRICE_ELITE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx

# ─── Resend (email) ─────────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@karmanprep.com
RESEND_AUDIENCE_ID=                          # for waitlist sign-ups

# ─── Cloudflare R2 (image + PDF storage) ────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=karmanprep-question-images
R2_PUBLIC_URL=https://images.karmanprep.com  # or pub-XXX.r2.dev

# ─── Zoom (video sessions) ──────────────────────────────────
# Server-to-server OAuth app. Marketplace → your app → App Credentials.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=                         # validates inbound webhook events

# ─── Cal.com (booking) ──────────────────────────────────────
CAL_API_KEY=cal_live_xxx
CAL_API_URL=https://api.cal.com/v2
CAL_WEBHOOK_SECRET=

# ─── Slack (cohort chat — DEFERRED, single-bot model) ───────
# Bot token from https://api.slack.com/apps → your app → OAuth & Permissions.
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_SIGNING_SECRET=

# ─── OpenAI (recap email drafting) ──────────────────────────
OPENAI_API_KEY=sk-proj-xxx

# ─── Fireflies (Zoom transcript ingestion) ──────────────────
FIREFLIES_API_KEY=                           # from https://app.fireflies.ai/integrations
FIREFLIES_WEBHOOK_TOKEN=                     # any long random string; goes in webhook URL

# ─── Sentry (error tracking) ────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_xxx                 # for source-map uploads
SENTRY_ORG=karmanprep
SENTRY_PROJECT=karmanprep-web

# ─── Cron + admin alerts ────────────────────────────────────
CRON_SECRET=                                 # bearer token gating /api/cron/*
ADMIN_NOTIFICATION_EMAIL=admin@karmanprep.com
MODERATION_ALERT_EMAIL=admin@karmanprep.com  # chat moderation flags route here

# ─── Math rendering (optional — Desmos for graphs) ──────────
NEXT_PUBLIC_DESMOS_API_KEY=                  # from https://www.desmos.com/api

# ─── Default fallback tutors (used when admin assigns auto) ─
DEFAULT_SEMINAR_TUTOR_CLERK=user_xxx
DEFAULT_SMALLGROUP_TUTOR_CLERK=user_xxx

# ─── Daemon / pipeline (mostly deprecated) ──────────────────
# Used by scripts/pdf-pipeline/* — only set if running the local Claude
# question-extraction daemon (replaced by ChatGPT Custom GPT for prod).
CLAUDE_BIN=                                  # absolute path to claude CLI binary
GEMINI_MODEL=gemini-2.5-flash                # model used by stage2_classify.py
CHUNK_PAGES=15                               # PDF page chunk size for Claude

# ─── Test scripts (for scripts/tests/*) ─────────────────────
# Optional. Used by ad-hoc smoke-test scripts.
TEST_DM_BENNISZ_EMAIL=
TEST_DM_TEXT=
TEST_REPLY_BENNISZ_EMAIL=
TEST_REPLY_TEXT=
TEST_REPLY_IMAGE_URL=
