# Cloudflare Workers static assets (wrangler.toml [assets]): cache rules for files served straight from
# .open-next/assets. Next.js's own file names under /_next/static change with every build, so they keep
# forever; the site's photos and films keep a day and refresh in the background.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/site/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff
