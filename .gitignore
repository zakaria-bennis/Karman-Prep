# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# Cloudflare / OpenNext build output (regenerated on every build)
/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code (local scratchpad, worktrees, session state)
.claude/

# Supabase CLI local state (version cache, project link, etc.)
/supabase/.temp/

# PDF-ingestion routine — keep folder structure + README/prompt
# in repo, ignore everything else (PDFs, run outputs, logs). The
# .gitkeep file in each subdir preserves the directory.
/question-imports/incoming/*
!/question-imports/incoming/.gitkeep
/question-imports/done/*
!/question-imports/done/.gitkeep
/question-imports/runs/*
!/question-imports/runs/.gitkeep
/question-imports/extract-out/
/question-imports/.pdf-watch.log
/question-imports/*.log

# Playwright artifacts
/test-results/
/playwright-report/
/playwright/.cache/

# Visual snapshot harness output
/tests/visual/snapshots/

# Real-device captures — keep README + .gitkeep, ignore PNGs
/tests/visual/real-device-captures/*
!/tests/visual/real-device-captures/README.md
!/tests/visual/real-device-captures/.gitkeep
